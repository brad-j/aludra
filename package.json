{
  "name": "aludra",
  "version": "0.1.0",
  "private": true,
  "description": "Run coding agents on your own machines and reach them from your Mac and the terminal, over Tailscale",
  "bin": {
    "aludra": "dist/host/main.js"
  },
  "files": [
    "dist/host"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "aludra": "node --no-warnings src/main.ts",
    "serve": "node --no-warnings src/main.ts serve",
    "doctor": "node --no-warnings src/main.ts doctor",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc && pnpm lint && pnpm test",
    "lint": "oxlint --deny-warnings src test scripts",
    "test": "node --no-warnings --test test/*.test.ts",
    "prepack": "pnpm build"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@earendil-works/pi-telemetry": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "jiti": "2.7.0",
    "pi-claude-bridge": "0.9.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  }
}
